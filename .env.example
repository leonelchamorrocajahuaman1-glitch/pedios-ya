# ---------------------------------------------------------------
# Mikuy · variables de entorno (copiar a .env.local o a Vercel)
# ---------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # clave anon / publishable (pública)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SOLO servidor: webhooks y enlaces de repartidor. Nunca NEXT_PUBLIC_

# URL pública del sitio (sin "/" final). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox (mapas de seguimiento y búsqueda de direcciones) → account.mapbox.com → Access tokens
# Restringe el token a tu dominio (URL restrictions).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Mercado Pago Perú (tarjetas) → mercadopago.com.pe/developers → Tus integraciones
MERCADOPAGO_ACCESS_TOKEN=                       # APP_USR-... (producción) o TEST-... (pruebas)
MERCADOPAGO_WEBHOOK_SECRET=                     # "Clave secreta" de la sección Webhooks
