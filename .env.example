# ---------------------------------------------------------------
# Mikuy · variables de entorno (copiar a .env.local o a Vercel)
# Nunca subas valores reales de las variables secretas a GitHub.
# ---------------------------------------------------------------

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave PÚBLICA. Usa UNA de las dos (si existen ambas, gana la publishable):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # recomendada (formato nuevo)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                    # legacy anon key

# Clave SECRETA, solo servidor (webhooks y enlaces de repartidor). Usa UNA de las dos:
SUPABASE_SERVICE_ROLE_KEY=                                # legacy service_role (eyJ...)
# SUPABASE_SECRET_KEY=sb_secret_...                       # formato nuevo

# URL pública del sitio (sin "/" final). Se incrusta al compilar: redeploy si cambia.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional · Mapbox (mapa de seguimiento y búsqueda de direcciones). Restringe el token a tu dominio.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Opcional · Mercado Pago Perú (tarjetas). Sin estas variables el pago con tarjeta queda desactivado.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
